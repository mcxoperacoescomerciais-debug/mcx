# MCX Operações — variáveis de ambiente (nunca reutilizar as do MCX Campo)
# Banco PRÓPRIO do Operações (projeto Supabase separado). Vazio = banco embutido de desenvolvimento.
DATABASE_URL=
# Segredo da sessão (gere um novo, diferente do Campo).
SESSION_SECRET=
# "false" desliga o sistema inteiro.
OPS_ENABLED=true
# Opcional: senha inicial da equipe no primeiro bootstrap (troca obrigatória no primeiro acesso).
OPS_INITIAL_PASSWORD=
# Segredo do cron das rotinas (Authorization: Bearer ...). Sem ele a rota fica fechada.
CRON_SECRET=
