# Copie para .env.local (desenvolvimento) ou configure no provedor de hospedagem.

# Banco. Em desenvolvimento pode ficar vazio: usa o Postgres embutido (PGlite)
# em .data/pglite, já com dados de demonstração.
# Produção (Supabase): URL do POOLER (porta 6543) para o app e a URL DIRETA
# (porta 5432) para rodar npm run db:migrate.
DATABASE_URL=

# Chave para assinar as sessões (gere com: openssl rand -base64 32). Obrigatória em produção.
SESSION_SECRET=

# Fotos no Supabase Storage (bucket PRIVADO). Sem isso, as fotos vão para .data/uploads.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=campo-evidencias

# Somente desenvolvimento: senha dos usuários de demonstração do seed.
DEMO_PASSWORD=

# Site institucional da MCX: o botão "Institucional" das páginas de escopo
# (/escopo/...) leva para este endereço. Vazio = botão oculto.
MCX_SITE_URL=

# Sugestões de melhoria: análise automática pelo Claude (chave da Anthropic,
# criada em console.anthropic.com). Vazio = a sugestão é salva sem análise.
ANTHROPIC_API_KEY=
# Aviso de nova sugestão no WhatsApp da equipe MCX (CallMeBot; vários números
# separados por vírgula, uma chave para cada). APP_URL monta o link do aviso.
MCX_ALERT_WHATSAPP_PHONE=
MCX_ALERT_WHATSAPP_APIKEY=
APP_URL=
