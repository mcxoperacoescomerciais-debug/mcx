# Copie este arquivo para ".env" e preencha os valores reais.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# Banco local (padrão já funciona, normalmente não precisa mudar)
DATABASE_URL=sqlite:///./data/mcx_tracker.db

# Caminho do JSON de credenciais da Service Account do Google
GOOGLE_SERVICE_ACCOUNT_FILE=./data/credentials/service_account.json

# Provedor de Vision AI: "openai" ou "gemini"
VISION_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Limite mínimo de confiança (0.0 a 1.0) para gravar automaticamente sem revisão humana
CONFIDENCE_THRESHOLD=0.95

# Pastas de dados locais (padrão já funciona)
WHATSAPP_SESSION_DIR=./data/sessions
MEDIA_DIR=./data/media
