# Copie para .env.local (desenvolvimento) ou configure no provedor de hospedagem.

# Banco. Em desenvolvimento pode ficar vazio: usa o Postgres embutido (PGlite)
# em .data/pglite, já com dados de demonstração.
# Produção (Supabase): use a URL do POOLER (porta 6543) para o app
# e a URL DIRETA (porta 5432) para rodar npm run db:migrate.
DATABASE_URL=

# Chave para assinar as sessões (gere com: openssl rand -base64 32). Obrigatória em produção.
SESSION_SECRET=

# Fotos no Supabase Storage (bucket PRIVADO). Sem isso, as fotos vão para .data/uploads.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=occurrence-photos

# Somente desenvolvimento: senha dos usuários de demonstração do seed.
DEMO_PASSWORD=

# Alerta de validade crítica no WhatsApp (CallMeBot). Vazio = desligado.
# Número com DDI (ex.: +5537999998888). Vários: separe por vírgula, na mesma ordem.
ALERT_WHATSAPP_PHONE=
ALERT_WHATSAPP_APIKEY=
