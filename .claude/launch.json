{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "start:demo"
      ],
      "port": 3100
    },
    {
      "name": "campo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "agencia",
        "run",
        "dev",
        "--",
        "-p",
        "3200"
      ],
      "port": 3200
    },
    {
      "name": "campo-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "agencia",
        "run",
        "start:demo"
      ],
      "port": 3300
    },
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "site",
        "run",
        "dev"
      ],
      "port": 3400
    },
    {
      "name": "site-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve@14.2.4",
        "site/out",
        "-l",
        "3500"
      ],
      "port": 3500
    }
  ]
}
